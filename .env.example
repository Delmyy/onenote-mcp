# ─────────────────────────────────────────────────────────────────────────────
# OneNote MCP server — environment configuration
# Copy to `.env` and fill values via your secret manager / Azure Key Vault.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=8082
# Public path where the MCP endpoint is served (the MCP client points here).
MCP_PATH=/mcp

# ── MCP client → this server authentication ──────────────────────────────────
# A long random secret. The client sends it as `Authorization: Bearer <token>`.
# Generate with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# ── Microsoft Graph / Azure AD (Entra ID) app registration ───────────────────
GRAPH_API_BASE=https://graph.microsoft.com/v1.0

# "application" = OAuth client-credentials (app-only). Requires the Graph APPLICATION
#                 permission Notes.ReadWrite.All + admin consent. No user sign-in.
# "delegated"   = acts on behalf of a signed-in user. Requires the DELEGATED permission
#                 Notes.ReadWrite + offline_access, and a refresh token (see below).
GRAPH_AUTH_MODE=application

# Directory (tenant) ID and app (client) ID from the app registration Overview page.
GRAPH_TENANT_ID=replace-with-tenant-id
GRAPH_CLIENT_ID=replace-with-application-client-id
# Client secret VALUE (Certificates & secrets → New client secret). Store in Key Vault.
GRAPH_CLIENT_SECRET=replace-with-client-secret-value

# ── Target (whose notebooks) ─────────────────────────────────────────────────
# me | user | group | site.
#   application mode CANNOT use "me" (app-only has no user context).
#   delegated mode defaults to "me".
ONENOTE_TARGET_TYPE=user
# Required unless ONENOTE_TARGET_TYPE=me. For user: the UPN (e.g. da@lawctg.com) or object id.
# For group/site: the group id or site id.
ONENOTE_TARGET_ID=replace-with-user-upn-or-id

# ── Delegated mode only ──────────────────────────────────────────────────────
# Space-delimited delegated scopes used with the refresh_token grant.
GRAPH_DELEGATED_SCOPES=offline_access Notes.ReadWrite User.Read
# Redirect URI registered on the app (used by `npm run authorize`).
GRAPH_REDIRECT_URI=http://localhost:8082/oauth/callback
# Long-lived refresh token minted by `npm run authorize`. Required only in delegated mode.
GRAPH_REFRESH_TOKEN=replace-with-refresh-token-from-npm-run-authorize

# ── Write access (OFF by default) ────────────────────────────────────────────
# Leave false to expose ONLY read-only tools. Set true ONLY after review to expose the
# confirmation-gated write tools (create page, append to page).
ENABLE_WRITES=false

# ── Operational limits ───────────────────────────────────────────────────────
# Per-request timeout to Microsoft Graph (ms).
HTTP_TIMEOUT_MS=20000
# Max Graph requests per second this server will issue (client-side throttle).
RATE_LIMIT_RPS=5
# Log level: error | warn | info | debug  (bodies/content/tokens are never logged at any level)
LOG_LEVEL=info
